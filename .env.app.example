# Copy to .env.app.local before the first Docker startup.
# Keep real credentials out of Git. Local services are configured by Compose.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_USERNAME=systemadmin
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_NAME=ผู้ดูแลระบบ
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
