# Public hostnames routed to this server (DNS A/AAAA must point to the server)
APP_DOMAIN=exam.example.ac.th
FILES_DOMAIN=exam-files.example.ac.th
APP_ORIGIN=https://exam.example.ac.th

# PostgreSQL container. Generate a URL-safe password, for example: openssl rand -hex 32
# Do not use URL-reserved characters because Compose embeds this value in DATABASE_URL.
POSTGRES_DB=examsystem
POSTGRES_USER=exam_app
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
DATABASE_POOL_SIZE=10

# Better Auth / first administrator
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_USERNAME=systemadmin
BOOTSTRAP_ADMIN_EMAIL=admin@example.ac.th
BOOTSTRAP_ADMIN_NAME=ผู้ดูแลระบบเริ่มต้น
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password

# MinIO — root credentials are used only by the initialization container.
MINIO_ROOT_USER=exam_storage_admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-storage-password
MINIO_APP_ACCESS_KEY=exam_system_app
MINIO_APP_SECRET_KEY=replace-with-a-different-long-random-storage-password
STORAGE_BUCKET=exam-files

# Gmail App Password (requires Google 2-Step Verification; never use your Google login password)
MAIL_TRANSPORT=gmail-app-password
MAIL_FROM="ระบบจัดพิมพ์ข้อสอบ <sender@example.ac.th>"
GMAIL_USER=sender@example.ac.th
GMAIL_APP_PASSWORD=
# Legacy OAuth2 remains supported with MAIL_TRANSPORT=gmail instead.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
