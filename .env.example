# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# PostgreSQL (Docker defaults; change every production password)
DATABASE_URL=postgresql://exam_app:exam_local_password@localhost:5432/examsystem
DIRECT_DATABASE_URL=postgresql://exam_app:exam_local_password@localhost:5432/examsystem

# Private S3-compatible storage (MinIO)
# Internal endpoint is used by the app container. Public endpoint is signed into
# browser upload/download URLs and must resolve from the user's browser.
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=exam-files
STORAGE_INTERNAL_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

# Email: smtp (Mailpit), gmail-app-password, or gmail (legacy OAuth2)
MAIL_TRANSPORT=smtp
MAIL_FROM="ระบบจัดพิมพ์ข้อสอบ <no-reply@example.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# One-time initial administrator bootstrap (never commit real values)
BOOTSTRAP_ADMIN_USERNAME=systemadmin
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_NAME=ผู้ดูแลระบบเริ่มต้น
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Test-only credentials used by Playwright against a seeded local database
E2E_ADMIN_USERNAME=systemadmin
E2E_ADMIN_PASSWORD=replace-with-a-strong-password
